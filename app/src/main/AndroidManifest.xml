<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MichiApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LegendaJP"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RecordingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:parentActivityName=".RecordingsActivity" />

        <activity
            android:name=".StudyMenuActivity"
            android:exported="false"
            android:parentActivityName=".ViewerActivity" />

        <activity
            android:name=".StudyActivity"
            android:exported="false"
            android:parentActivityName=".StudyMenuActivity" />

        <activity
            android:name=".GrammarPickActivity"
            android:exported="false"
            android:parentActivityName=".StudyMenuActivity" />

        <!-- Modelo de leitura de japonês (OCR) baixado pelo Google Play ao instalar -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr_japanese" />

        <activity
            android:name=".TextsActivity"
            android:exported="true"
            android:label="Michi"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity">
            <!-- Compartilhar texto de outro app → Michi -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TextEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".TextsActivity" />

        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:parentActivityName=".TextsActivity" />

        <activity
            android:name=".ReportsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ReviewActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".WordPickActivity"
            android:exported="false"
            android:parentActivityName=".StudyMenuActivity" />

        <activity
            android:name=".MistakesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".StudyHistoryActivity"
            android:exported="false"
            android:parentActivityName=".StudyMenuActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LevelActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".MangaActivity"
            android:exported="false"
            android:parentActivityName=".TextsActivity" />

        <activity
            android:name=".GrammarDictActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".VocabActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".VocabDetailActivity"
            android:exported="false"
            android:parentActivityName=".VocabActivity" />

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>
